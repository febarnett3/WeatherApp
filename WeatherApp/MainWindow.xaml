<Window x:Class="WeatherApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Weather App"
        Height="430"
        Width="440"
        Background="#FDF6EC">

    <!-- GLOBAL STYLES -->
    <Window.Resources>

        <!-- Text styling -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#4B3832"/> <!-- warm brown -->
        </Style>

        <!-- Rounded Button Style -->
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#D37C4A"/> <!-- terracotta -->
            <Setter Property="BorderBrush" Value="Transparent"/>

            <!-- Define the rounded button look -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <!-- Hover and Press Triggers -->
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E5955E"/> <!-- lighter terracotta -->
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#A75B31"/> <!-- darker -->
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- TextBox styling -->
        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#4B3832"/>
            <Setter Property="Background" Value="#FFF5E1"/>  <!-- soft cream -->
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="BorderBrush" Value="#E1B382"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

    </Window.Resources>

    <!-- MAIN CONTENT -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Header -->
            <RowDefinition Height="Auto"/>   <!-- Input -->
            <RowDefinition Height="*"/>      <!-- Output -->
        </Grid.RowDefinitions>

        <!-- Title Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20" HorizontalAlignment="Center">
            <TextBlock Text="☀️ Weather App"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="#A75B31"
                       HorizontalAlignment="Center"/>
            <Rectangle Height="2"
                       Width="180"
                       Fill="#E1B382"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Input Row -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center">
            <TextBox x:Name="CityInput"
                     Width="250"
                     Height="30"
                     Text="City, State, Country"
                     Foreground="#A1887F"
                     GotFocus="CityInput_GotFocus"
                     LostFocus="CityInput_LostFocus"/>
            <Button Content="Get Weather"
                    Click="GetWeather_Click"
                    Width="110"
                    Height="30"/>
        </StackPanel>

        <!-- Output Box -->
        <Border Grid.Row="2"
                Margin="0,25,0,0"
                CornerRadius="12"
                Background="#FFE1C6"
                Padding="20">
            <Border.Effect>
                <DropShadowEffect Color="#000000"
                                  BlurRadius="15"
                                  Opacity="0.2"/>
            </Border.Effect>

            <TextBlock x:Name="OutputBlock"
                       Text="Enter a city and click Get Weather"
                       TextAlignment="Center"
                       FontSize="16"
                       FontWeight="Normal"
                       TextWrapping="Wrap"
                       Foreground="#4B3832"/>
        </Border>
    </Grid>
</Window>
